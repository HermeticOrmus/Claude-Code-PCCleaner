{
  "dry_run": true,
  "large_file_threshold_mb": 500,
  "inactive_project_days": 30,
  "temp_age_days": 7,
  "exclusions": {
    "directories": [
      "node_modules/.cache",
      ".git"
    ],
    "files": [
      ".env",
      "*.key",
      "*.pem"
    ]
  },
  "cache_paths": {
    "npm": "AppData/Local/npm-cache",
    "uv": "",
    "pip": "AppData/Local/pip/cache",
    "go": "go/pkg/mod/cache",
    "cargo": ".cargo/registry/cache"
  },
  "build_patterns": [
    ".next",
    "dist",
    "build",
    "target",
    "out",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache"
  ]
}
